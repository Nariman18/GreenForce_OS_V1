{
  "name": "@greenforce/backend",
  "version": "0.1.0",
  "private": true,
  "description": "GreenForce OS REST API (NestJS + Prisma)",
  "type": "module",
  "scripts": {
    "prisma:generate": "prisma generate",
    "build": "prisma generate && nest build",
    "dev": "prisma generate && nest start --watch --exec \"node --enable-source-maps --env-file-if-exists=.env.example --env-file-if-exists=.env\"",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "prisma generate && vitest run",
    "test:watch": "vitest",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate": "prisma migrate deploy",
    "db:check": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "db:seed": "node --env-file-if-exists=.env.example --env-file-if-exists=.env dist/db/cli.js seed",
    "db:reset": "node --env-file-if-exists=.env.example --env-file-if-exists=.env dist/db/cli.js reset"
  },
  "dependencies": {
    "@greenforce/shared": "0.1.0",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/swagger": "12.1.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "3.0.3",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.11",
    "@nestjs/testing": "12.3.2",
    "@swc/core": "1.16.21",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/supertest": "7.2.1",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.0"
  }
}
