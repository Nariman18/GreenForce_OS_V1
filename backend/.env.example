# GreenForce OS backend — DEVELOPMENT DEFAULTS.
# Loaded by docker-compose.yml (env_file) and the npm scripts. Put local overrides in backend/.env (git-ignored).
# These values are for local development only: replace every secret in any shared or production environment.

# ── PostgreSQL (also used by the postgres container) ─────────────────────
POSTGRES_USER=greenforce
POSTGRES_PASSWORD=greenforce-dev-only-password
POSTGRES_DB=greenforce
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Optional: a full connection string overrides the POSTGRES_* values above.
# DATABASE_URL=postgresql://user:password@host:5432/database

# ── API ──────────────────────────────────────────────────────────────────
API_PORT=4000
# At least 32 characters. Generate a real one with: openssl rand -hex 32
JWT_SECRET=dev-only-insecure-jwt-secret-replace-me-0000000000
SESSION_TTL_HOURS=8
# Set to true when served over HTTPS.
COOKIE_SECURE=false
# Origins allowed to call the API directly (the web app uses a same-origin proxy).
CORS_ORIGINS=http://localhost:3000
UPLOAD_DIR=./uploads
SWAGGER_ENABLED=true

# ── Demo ─────────────────────────────────────────────────────────────────
# Enables POST /api/v1/demo/reset and the "Reset demo" button.
DEMO_MODE=true
DEMO_USER_EMAIL=demo@greenforce.dev
DEMO_USER_PASSWORD=GreenForce-Demo-2026
