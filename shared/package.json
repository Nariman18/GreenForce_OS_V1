{
  "name": "@greenforce/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Zod schemas, inferred types, API contracts and constants for GreenForce OS",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "vitest": "5.1.0"
  }
}
