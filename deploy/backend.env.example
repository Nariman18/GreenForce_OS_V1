# GreenForce OS — runtime configuration for a deployed environment (staging / production).
# Copy to <DEPLOY_PATH>/backend.env on the Docker host, chmod 600, and replace EVERY placeholder.
# Never commit the filled-in file.

# ── PostgreSQL ─────────────────────────────────────────────────────────────
# Bundled database (COMPOSE_PROFILES=bundled-db, the default):
POSTGRES_USER=greenforce
POSTGRES_PASSWORD=<generate: openssl rand -hex 24>
POSTGRES_DB=greenforce
POSTGRES_PORT=5432
# Managed database instead: set DATABASE_URL (it overrides POSTGRES_*), e.g.
# DATABASE_URL=postgresql://user:password@db.example.com:5432/greenforce?sslmode=require

# ── API ────────────────────────────────────────────────────────────────────
JWT_SECRET=<generate: openssl rand -hex 32>
SESSION_TTL_HOURS=8
COOKIE_SECURE=true
CORS_ORIGINS=https://<your-domain>
SWAGGER_ENABLED=false

# ── Demo ───────────────────────────────────────────────────────────────────
# true only for demo/staging environments: seeds demo data and enables the "Reset demo" endpoint.
DEMO_MODE=false
DEMO_USER_EMAIL=demo@greenforce.dev
DEMO_USER_PASSWORD=<only needed when DEMO_MODE=true>
